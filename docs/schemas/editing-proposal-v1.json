{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:cutcat:editing-proposal:1",
  "title": "CutCat selected-object editing candidate v1",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "commands"],
  "properties": {
    "schema_version": {"const": 1, "type": "integer"},
    "commands": {"type": "array", "minItems": 1, "maxItems": 8, "items": {
      "oneOf": [
        {"type": "object", "additionalProperties": false,
         "required": ["op", "target_id", "text"],
         "properties": {"op": {"const": "caption.replace_text"}, "target_id": {"type": "string", "minLength": 1, "maxLength": 128}, "text": {"type": "string", "minLength": 1, "maxLength": 1000}}},
        {"type": "object", "additionalProperties": false,
         "required": ["op", "target_id", "gain_db"],
         "properties": {"op": {"const": "clip.set_gain_db"}, "target_id": {"type": "string", "minLength": 1, "maxLength": 128}, "gain_db": {"type": "number", "minimum": -96, "maximum": 24}}}
      ]
    }}
  }
}
